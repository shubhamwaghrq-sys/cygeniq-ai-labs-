# ============================================================
# Cygeniq AI Labs — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file — it is excluded by .gitignore
# ============================================================

# ── LLM (Groq API) ────────────────────────────────────────
# Get your key at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Database (Supabase PostgreSQL) ────────────────────────
# Format: postgresql://[user]:[password]@[host]:[port]/[db]
# Get from: https://supabase.com → Settings → Database → Connection string
SUPABASE_URL=postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres

# ── Azure / SharePoint MCP ────────────────────────────────
# Register an App at: https://portal.azure.com → Azure Active Directory → App registrations
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here

# ── Gmail IMAP/SMTP ───────────────────────────────────────
# Enable 2FA on your Google Account first, then generate an App Password:
# https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=your@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Optional / Internal APIs ──────────────────────────────
INTERNAL_API_BASE=https://internal-mcp.company.local
INTERNAL_API_TOKEN=your_oauth_token_here
